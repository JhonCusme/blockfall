			<key>SKAdNetworkIdentifier</key>
			<string>3sh42y64q3.skadnetwork</string>
		</dict>
	</array>

	<!-- ═══════════════════ Inicio de sesión con Google ═══════════════════
	     El esquema de URL debe ser el CLIENT ID de iOS invertido, tal cual
	     aparece en el GoogleService-Info.plist como REVERSED_CLIENT_ID.
	     Pendiente hasta crear la app de iOS en Firebase. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>PENDIENTE_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>
